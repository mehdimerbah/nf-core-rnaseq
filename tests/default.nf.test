nextflow_pipeline {
    name "RNA-seq pipeline regression tests"
    script "../main.nf"
    tag "pipeline"

    test("STAR baseline") {
        when { params { outdir = "$outputDir" } }
        then {
            assertAll(
                { assert workflow.success },
                { assert file("$outputDir/samtools/mapped.sorted.bam").exists() },
                { assert file("$outputDir/multiqc/multiqc_report.html").exists() }
            )
        }
    }

    test("Bowtie2 with prepared-matrix DESeq2") {
        when {
            params {
                outdir = "$outputDir"
                aligner = "bowtie2"
                run_deseq2 = true
                deseq2_samplesheet = "$projectDir/validation/small/deseq2_samplesheet.csv"
                deseq2_counts = "$projectDir/validation/small/counts_for_deseq2.tsv"
                deseq2_contrast_variable = "condition"
                deseq2_reference = "WT"
                deseq2_target = "KO"
                deseq2_vst_nsub = 10
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert file("$outputDir/samtools/mapped.sorted.bam").exists() },
                { assert file("$outputDir/deseq2/KO_vs_WT.deseq2.results.tsv").exists() }
            )
        }
    }

    test("HISAT2 with gene and exon featureCounts") {
        when {
            params {
                outdir = "$outputDir"
                aligner = "hisat2"
                run_featurecounts = true
                run_featurecounts_exon = true
            }
        }
        then {
            assertAll(
                { assert workflow.success },
                { assert file("$outputDir/featurecounts/mapped.gene.featureCounts.tsv").exists() },
                { assert file("$outputDir/featurecounts/mapped.exon.featureCounts.tsv").exists() }
            )
        }
    }
}
