/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for STAR aligner
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the RNA-seq pipeline with STAR aligner.

    Use as follows:
        nextflow run main.nf -profile aligner_star,conda --input samplesheet.csv

    Or combine with other profiles:
        nextflow run main.nf -profile test_EB1,aligner_star,conda

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'STAR Aligner Profile'
    config_profile_description = 'Configuration for STAR splice-aware aligner'

    // Input data - using local test samplesheet
    input = 'samplesheet_AT_mm_a4.csv'

    // Aligner selection
    aligner = 'star'

    // Output directory
    outdir = './results_star_mm/'

    // Genome references - using local files
    igenomes_ignore = true
    fasta = "${projectDir}/mm_samples/genome.fa"
    gtf = "${projectDir}/mm_samples/genes.gtf"
    igv_gff = 'mm_samples/GCF_000001635.27_GRCm39_genomic.gff'

    // FastQC options
    fastqc_threads = '32'

    // TrimGalore options
    trimgalore_min_length = '20'
    trimgalore_min_qual = '20'

    // STAR-specific options
    readFilesCommand = 'zcat'
    outSAMtype = 'BAM SortedByCoordinate'

    // Picard options
    picard_prefix = 'picard'

    // MERGESTRINGTIE options
    genetable_outfile = 'gene_table_TPM'
}
