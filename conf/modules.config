/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    withName: TRIMGALORE {
        ext.args   = { [
            params.trimgalore_min_length ? "--length \"$params.trimgalore_min_length\"" : '',
            params.trimgalore_min_qual ? "--quality ${params.trimgalore_min_qual}" : ''
            ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/trimgalore" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'STAR_GENOMEGENERATE' {
        ext.args   = { '' }
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'STAR_ALIGN' {
        ext.args   = { [
            params.readFilesCommand ? "--readFilesCommand ${params.readFilesCommand}" : '',
            params.outSAMtype ? "--outSAMtype ${params.outSAMtype}" : ''
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/star" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BOWTIE2_BUILD' {
        publishDir = [
            path: { "${params.outdir}/bowtie2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BOWTIE2_ALIGN' {
        ext.args   = { "--very-sensitive --no-unal --rg-id ${meta.id} --rg SM:${meta.id} --rg PL:ILLUMINA --rg LB:${meta.id}" }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/bowtie2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'HISAT2_EXTRACTSPLICESITES' {
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'HISAT2_BUILD' {
        memory = { 48.GB * task.attempt }
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'HISAT2_ALIGN' {
        ext.args   = { [
        '-q'
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        publishDir = [
            path: { "${params.outdir}/samtools" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FEATURECOUNTS_GENE' {
        // Gene-level counting from GTF exon records grouped by gene_id.
        // Paired-end mode and strandedness are set by the module from sample metadata.
        ext.args   = { [
            params.fc_count_multimappers ? '-M' : '--primary',
            params.fc_count_multimappers ? '-O' : '',
            '-F GTF',
            '-t exon',
            '-g gene_id',
        ].join(' ') }
        ext.prefix = { "${meta.id}.gene" }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FEATURECOUNTS_EXON' {
        // Feature-level exon counting from GTF exon records.
        // Paired-end mode and strandedness are set by the module from sample metadata.
        ext.args   = { [
            params.fc_count_multimappers ? '-M' : '--primary',
            params.fc_count_multimappers ? '-O' : '',
            '-f',
            '-F GTF',
            '-t exon',
            '-g gene_id',
        ].join(' ') }
        ext.prefix = { "${meta.id}.exon" }
        publishDir = [
            path: { "${params.outdir}/featurecounts" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ========================================================================
    // DESeq2 Differential Expression Analysis
    // ========================================================================
    withName: 'DESEQ2_DIFFERENTIAL' {
        ext.args = [
            "--gene_id_col ${params.deseq2_gene_id_col}",
            "--sample_id_col ${params.deseq2_sample_id_col}",
            "--alpha ${params.deseq2_alpha}",
            "--lfc_threshold ${params.deseq2_lfc_threshold}",
            "--shrink_lfc ${params.deseq2_shrink_lfc}",
            "--fit_type ${params.deseq2_fit_type}",
            "--vs_method ${params.deseq2_vs_method}",
            "--vst_nsub ${params.deseq2_vst_nsub}"
        ].join(' ')
        publishDir = [
            path: { "${params.outdir}/deseq2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
