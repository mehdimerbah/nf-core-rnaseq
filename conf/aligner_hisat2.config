/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for HISAT2 aligner
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the RNA-seq pipeline with HISAT2 aligner.

    Use as follows:
        nextflow run main.nf -profile aligner_hisat2,conda --input samplesheet.csv

    Or combine with other profiles:
        nextflow run main.nf -profile test_EB1,aligner_hisat2,conda

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'HISAT2 Aligner Profile'
    config_profile_description = 'Configuration for HISAT2 splice-aware aligner'

    // Input data - using local test samplesheet
    input = 'samplesheet_AT_mm_a4.csv'
    
    // Aligner selection
    aligner = 'hisat2'

    // Output directory
    outdir = './results_hisat2_mm/'

    // Genome references - using local files
    igenomes_ignore = true
    fasta = "${projectDir}/mm_samples/genome.fa"
    gtf = "${projectDir}/mm_samples/genes.gtf"
    igv_gff = 'mm_samples/GCF_000001635.27_GRCm39_genomic.gff'

    // FastQC options
    fastqc_threads = '32'

    // TrimGalore options
    trimgalore_min_length = '20'
    trimgalore_min_qual = '20'

    // STAR alignment options (used by workflow even with bowtie2)
    readFilesCommand = 'zcat'
    outSAMtype = 'BAM SortedByCoordinate'

    // Picard options
    picard_prefix = 'picard'

    // MERGESTRINGTIE options
    genetable_outfile = 'gene_table_TPM'

    // HISAT2-specific options
    hisat2_index = "${projectDir}/hisat2_index/grcm39"  // GRCm39 HISAT2 index (base name without .ht2)
    hisat2_build_memory = 48.GB
    save_unaligned = false
}
